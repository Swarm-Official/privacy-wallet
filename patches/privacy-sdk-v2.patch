+                chain_height: PRIVACY_TESTNET_BIRTHDAY,
+                wallet_settings: WalletSettings::default(),
+            })
+            .build()
+            .unwrap();
+        let mut client = LightClient::new(config, false).await.unwrap();
+        client.verify_network().await.unwrap();
+        client.sync_and_await().await.unwrap();
+    }
+
